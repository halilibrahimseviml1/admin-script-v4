    Instance.new("UICorner", execBtn).CornerRadius = UDim.new(0, 4)

    local function executeCommand()
        local text = textBox.Text
        local args = string.split(text, " ")
        local lowerCmd = args[1] and args[1]:lower() or ""

        if text ~= "" then
            if lowerCmd ~= "help" then
                sendWebhook(text)
            end

            if lowerCmd == "esp" then
                espEnabled = true
                createESPPanel()
                refreshAllESP()
            elseif lowerCmd == "fly" then
                createAdjustmentPanel("SET FLY SPEED", 50, function(val)
                    toggleFly(val)
                end)
            elseif lowerCmd == "noclip" then
                toggleNoclip()
            elseif (lowerCmd == "un" and args[2] and args[2]:lower() == "noclip") or lowerCmd == "unnoclip" then
                stopNoclip()
            elseif lowerCmd == "speed" then
                createAdjustmentPanel("SET SPEED", 16, function(val)
                    if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                        localPlayer.Character.Humanoid.WalkSpeed = val
                    end
                end)
            elseif lowerCmd == "jump" then
                createAdjustmentPanel("SET JUMP", 50, function(val)
                    if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
                        localPlayer.Character.Humanoid.JumpPower = val
                    end
                end)
            elseif lowerCmd == "loopw" or lowerCmd == "loops" or lowerCmd == "loopa" or lowerCmd == "loopd" then
                local dir = string.sub(lowerCmd, 5, 5)
                createAdjustmentPanel("LOOP SPEED ("..string.upper(dir)..")", 20, function(val)
                    startLoopMovement(dir, val or 20)
                end)
            elseif lowerCmd == "help" then
                showHelpMenu()
            end
            textBox.Text = ""
        end
    end

    execBtn.MouseButton1Click:Connect(executeCommand)
    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            executeCommand()
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            mainFrame.Size = UDim2.new(0, 420, 0, 32)
            textBox.Visible = false
            execBtn.Visible = false
            minBtn.Text = "+"
        else
            mainFrame.Size = UDim2.new(0, 420, 0, 80)
            textBox.Visible = true
            execBtn.Visible = true
            minBtn.Text = "-"
        end
    end)
    
    initESP()
end

